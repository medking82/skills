{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "peer-review-gate@peer-review-gate-marketplace": true
  },
  "extraKnownMarketplaces": {
    "peer-review-gate-marketplace": {
      "source": {
        "repo": "medking82/peer-review-gate",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/hook-launch.js",
              "no-polling-wait.py"
            ],
            "command": "node",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
